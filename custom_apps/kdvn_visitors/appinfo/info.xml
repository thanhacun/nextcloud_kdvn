	<version>0.5.2</version>
	<licence>agpl</licence>
	<author>KDVN IT</author>
	<namespace>KdvnVisitors</namespace>
	<category>organization</category>
	<dependencies>
		<nextcloud min-version="30" max-version="34"/>
	</dependencies>
	<background-jobs>
		<job>OCA\KdvnVisitors\BackgroundJob\Housekeeping</job>
	</background-jobs>
	<settings>
		<admin>OCA\KdvnVisitors\Settings\Admin</admin>
		<admin-section>OCA\KdvnVisitors\Settings\Section</admin-section>
	</settings>
	<navigations>
		<navigation>
			<name>Visitors</name>
			<route>kdvn_visitors.page.index</route>
			<icon>app.svg</icon>
		</navigation>
	</navigations>
</info>
